# ===== LLM (any OpenAI-compatible endpoint) =====
MODEL_NAME=qwen3.7-plus
API_KEY=your-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0
# Provider-specific request fields as JSON, e.g. {"enable_thinking": false} for Bailian Qwen3
LLM_EXTRA_BODY=
# Optional backup model on the same endpoint, used when MODEL_NAME fails
FALLBACK_MODEL_NAME=

# ===== Embedding =====
# provider: openai_compatible (now) | local (reserved for later)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# leave empty to reuse API_KEY / BASE_URL above
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ===== Web search (optional, mock mode if empty) =====
TAVILY_API_KEY=
# Enables POST /admin/reload; leave empty to keep admin endpoints disabled
ADMIN_TOKEN=

# ===== Local paths =====
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_base
TOOL_LOG_PATH=./logs/tool_calls.jsonl